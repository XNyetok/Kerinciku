{
  "name": "kerinciku",
  "private": true,
  "version": "0.0.0",
  "description": "Jelajah Kerinci: a browser game for children about the nature and culture of Kerinci.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "game:dev": "vite game",
    "game:build": "tsc -p game && vite build game",
    "game:preview": "vite preview game"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
